<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find js5_sitl)/models/js5/urdf/components/wamv_3d_lidar.xacro"/>
  
  <xacro:macro name="lidar"
               params="type:='16_beam'
                         name
                         x:=0.9 y:=0 z:=1.5
                         R:=0 P:=0 Y:=0
                         post_Y:=0 post_z_from:=1.2965">

    <!-- Use wamv_3d_lidar macro for both 16_beam and 32_beam configurations -->
    <xacro:if value="${type == '16_beam'}">
      <xacro:wamv_3d_lidar name="${name}"
                           x="${x}" y="${y}" z="${z}"
                           R="${R}" P="${P}" Y="${Y}"
                           post_Y="${post_Y}" post_z_from="${post_z_from}"
                           vertical_lasers="16"
                           samples="1875"
                           resolution="1"
                           min_angle="${-pi}"
                           max_angle="${pi}"
                           min_vertical_angle="${-pi/12}"
                           max_vertical_angle="${pi/12}"
                           max_range="130"
                           noise_stddev="0.01"/>
    </xacro:if>
    
    <xacro:if value="${type == '32_beam'}">
      <xacro:wamv_3d_lidar name="${name}"
                           x="${x}" y="${y}" z="${z}"
                           R="${R}" P="${P}" Y="${Y}"
                           post_Y="${post_Y}" post_z_from="${post_z_from}"
                           vertical_lasers="32"
                           samples="2187"
                           resolution="1"
                           min_angle="${-pi}"
                           max_angle="${pi}"
                           min_vertical_angle="-0.186"
                           max_vertical_angle="0.54"
                           max_range="130"
                           noise_stddev="0.01"/>
    </xacro:if>
  </xacro:macro>
</robot>

<!-- x:=0.7 y:=0 z:=1.8 -->